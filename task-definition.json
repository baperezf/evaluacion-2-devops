{
  "family": "innovatech-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::326599159805:role/LabRole",
  "taskRoleArn": "arn:aws:iam::326599159805:role/LabRole",
  "containerDefinitions": [
    {
      "name": "proyecto-frontend",
      "image": "326599159805.dkr.ecr.us-east-1.amazonaws.com/proyecto-frontend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ]
    },
    {
      "name": "proyecto-back-ventas",
      "image": "326599159805.dkr.ecr.us-east-1.amazonaws.com/proyecto-back-ventas:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8081,
          "hostPort": 8081,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "DB_HOST", "value": "172.31.5.237" }
      ]
    },
    {
      "name": "proyecto-back-despachos",
      "image": "326599159805.dkr.ecr.us-east-1.amazonaws.com/proyecto-back-despachos:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8082,
          "hostPort": 8082,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "DB_HOST", "value": "172.31.5.237" }
      ]
    }
  ]
}